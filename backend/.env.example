# Yatri.in Backend Production Environment Variables Template
PORT=5000
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173,https://your-vercel-app.vercel.app
CSRF_PROTECTION=false

# --- DATABASE CONFIGURATION ---
# MongoDB Database URI (Primary)
MONGODB_URI=mongodb://127.0.0.1:27017/yatriin

# PostgreSQL / Supabase URI (Optional database migration targets)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
DATABASE_URL=postgresql://postgres:password@localhost:5432/yatriin

# --- AUTHENTICATION CONFIGURATION ---
# Standard Local JWT Secrets
JWT_SECRET=your_jwt_signing_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_token_secret_key

# Clerk Auth Keys (Alternative Clerk Auth integration)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- GOOGLE MAPS PLATFORM KEYS ---
# Google Maps JavaScript / Places / Geocoding API key
GOOGLE_MAPS_API_KEY=AIzaSy...Your_Key_Here

# --- WEATHER INTEGRATION ---
# OpenWeatherMap API key (5-day forecast, current status)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# --- PAYMENT INTEGRATION ---
# Razorpay payment checkout keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
